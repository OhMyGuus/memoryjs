{
  "name": "memoryjs",
  "version": "0.0.7",
  "description": "Node add-on for memory reading and writing on linux!",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "install": "node-gyp-build",
    "build32": "node-gyp clean configure build --arch=ia32",
    "build64": "node-gyp clean configure build --arch=x64",
    "prebuild": "prebuildify --napi",
    "prebuild:ia32": "prebuildify --napi --arch ia32 --target node@22.23.2",
    "buildtest": "cd test && MSBuild.exe project.sln //p:Configuration=Release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rob--/memoryjs.git"
  },
  "keywords": [
    "memory",
    "reading",
    "writing",
    "management",
    "addon"
  ],
  "author": "Rob--",
  "license": "MIT",
  "gypfile": true,
  "bugs": {
    "url": "https://github.com/Rob--/memoryjs/issues"
  },
  "homepage": "https://github.com/Rob--/memoryjs#readme",
  "dependencies": {
    "concentrate": "^0.2.3",
    "dissolve": "^0.3.3",
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "4.x.x"
  },
  "devDependencies": {
    "prebuildify": "6.x.x"
  }
}
